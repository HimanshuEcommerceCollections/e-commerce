    {
      "name": "Orders",
      "description": "Customer endpoints use `customerToken`. `Mark order paid` uses `adminToken`.",
      "item": [
        {
          "name": "Checkout (place order)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "const order = data.order || data;",
                  "if (order && order.id) pm.collectionVariables.set('orderId', order.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Optional. Sending the same key again returns the original order instead of creating a second one. Reusing a key with a different request returns `422`."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"addressId\": \"{{addressId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "Turns the caller's cart into an order, reserves stock and starts payment with the active gateway.\n\n- `manual` gateway: the order waits in `PENDING_PAYMENT` until an admin calls **Mark order paid**.\n- `stripe` gateway: the response includes the PaymentIntent client secret for Stripe Elements. The webhook confirms payment, and unpaid orders expire after `ORDER_PENDING_EXPIRY_MINUTES`.\n\nErrors: `400` validation, invalid idempotency key or empty cart; `404` address not found; `409` out of stock or product unavailable; `422` idempotency key reused with a different request; `502` payment gateway error."
          },
          "response": []
        },
        {
          "name": "List my orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders?page=0&size=20&sort=createdAt,desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                },
                {
                  "key": "sort",
                  "value": "createdAt,desc"
                }
              ]
            },
            "description": "Paginated order summaries without line items."
          },
          "response": []
        },
        {
          "name": "Get my order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}"
              ]
            },
            "description": "Full order with items and shipping address. `404` if it is not the caller's order."
          },
          "response": []
        },
        {
          "name": "Cancel my order",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}",
                "cancel"
              ]
            },
            "description": "Cancels the order and restocks its items. `409` if the order is in a state that can't be cancelled."
          },
          "response": []
        },
        {
          "name": "Mark order paid (admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}/pay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}",
                "pay"
              ]
            },
            "description": "Requires `ROLE_ADMIN`. Moves a `PENDING_PAYMENT` order to `PAID`. Used with the `manual` payment gateway."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Payments (Stripe)",
      "description": "These endpoints exist only when `PAYMENT_PROVIDER=stripe`. Otherwise they return `404`.",
      "item": [
        {
          "name": "Stripe webhook",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Stripe-Signature",
                "value": "t=0,v1=replace_me",
                "description": "Required. Stripe computes this over the raw body. Postman can't generate a valid one."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_test\",\n  \"type\": \"payment_intent.succeeded\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/stripe/webhook",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "stripe",
                "webhook"
              ]
            },
            "description": "Public. Stripe calls it; authenticity comes from the signature. This request documents the contract only and returns `400` because its signature is fake. To test for real, run `stripe listen --forward-to localhost:8080/api/payments/stripe/webhook` and `stripe trigger payment_intent.succeeded`."
          },
          "response": []
        },
        {
          "name": "Replay webhook event (admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payments/stripe/webhook-events/{{webhookEventId}}/replay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "stripe",
                "webhook-events",
                "{{webhookEventId}}",
                "replay"
              ]
            },
            "description": "Requires `ROLE_ADMIN`. Re-dispatches a stored `FAILED` webhook event (`evt_…`) from the `webhook_events` table. Errors: `404` unknown event, `409` event not replayable."
          },
          "response": []
        }
      ]
