    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response uses the ApiResponse envelope', function () {",
          "    if (pm.request.url.getPath().startsWith('/actuator')) return;",
          "    if (!pm.response.headers.get('Content-Type') || !pm.response.headers.get('Content-Type').includes('json')) return;",
          "    const body = pm.response.json();",
          "    pm.expect(body).to.have.property('success');",
          "});"
        ]
      }
    }
  ],
