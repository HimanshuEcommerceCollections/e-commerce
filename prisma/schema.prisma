// NexusCommerce schema — the Java server's Flyway V1–V10 schema plus the
// storefront/operations additions (2_storefront_operations).
//
// prisma/migrations/0_init is those Flyway scripts verbatim, so a fresh database
// ends up exactly where the Java server leaves one. Things Prisma can't express
// live only in migration SQL and must never be dropped by a later migration:
//   * partial unique indexes: uniq_user_addresses_default, uniq_product_images_primary,
//     uniq_orders_user_idempotency_key, uniq_carts_user_live, uniq_cart_items_cart_product_live
//     (0_init); uniq_orders_guest_idempotency_key, uniq_products_url_slug (2_storefront_operations)
//   * CHECK chk_products_stock_non_negative
// Review every generated migration for DROP INDEX / DROP CONSTRAINT on these.
//
// Status-like columns are varchar, not Postgres enums (as in the Java schema);
// their allowed values are TypeScript unions in src/common/enums.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deleted           Boolean   @default(false)
  email             String    @unique(map: "uk_users_email") @db.VarChar(255)
  password          String    @db.VarChar(255)
  role              String    @db.VarChar(20)
  enabled           Boolean   @default(true)
  accountNonLocked  Boolean   @default(true) @map("account_non_locked")
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(6)
  fullName          String    @map("full_name") @db.VarChar(200)
  phoneNumber       String?   @unique(map: "uk_users_phone") @map("phone_number") @db.VarChar(20)
  marketingOptIn    Boolean   @default(false) @map("marketing_opt_in")
  /// Tokens issued before this instant are rejected (password change signs out other devices).
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(6)

  carts               Cart[]
  addresses           UserAddress[]
  orders              Order[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

/// A department (parentId null) or a subcategory/"section" of one (FR-ST-02).
model ProductCategory {
  id          String           @id @default(uuid()) @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deleted     Boolean          @default(false)
  name        String           @db.VarChar(100)
  slug        String           @unique(map: "uk_product_categories_slug") @db.VarChar(120)
  description String?          @db.VarChar(500)
  parentId    String?          @map("parent_id") @db.Uuid
  position    Int              @default(0)
  /// SKU code segment: CL for a department, MEN for a subcategory.
  code        String?          @db.VarChar(10)
  parent      ProductCategory? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_product_categories_parent")

  subcategories             ProductCategory[] @relation("CategoryTree")
  products                  Product[]
  parentProducts            ParentProduct[]   @relation("ParentProductCategory")
  subcategoryParentProducts ParentProduct[]   @relation("ParentProductSubcategory")

  @@index([parentId], map: "idx_product_categories_parent_id")
  @@map("product_categories")
}

/// The catalog record customers browse (FR-IM-02); purchasable variants are Product rows.
model ParentProduct {
  id                String           @id @default(uuid()) @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deleted           Boolean          @default(false)
  code              String           @unique(map: "uk_parent_products_code") @db.VarChar(100)
  name              String           @db.VarChar(255)
  brand             String?          @db.VarChar(100)
  shortDescription  String?          @map("short_description") @db.VarChar(1000)
  description       String?
  categoryId        String?          @map("category_id") @db.Uuid
  merchantId        String           @map("merchant_id") @db.Uuid
  subcategoryId     String?          @map("subcategory_id") @db.Uuid
  productType       String?          @map("product_type") @db.VarChar(100)
  /// Newline-separated bullet points.
  keyFeatures       String?          @map("key_features")
  whatsIncluded     String?          @map("whats_included")
  usageInstructions String?          @map("usage_instructions")
  warranty          String?          @db.VarChar(500)
  lifestyleImageUrl String?          @map("lifestyle_image_url") @db.VarChar(2048)
  sizeChartUrl      String?          @map("size_chart_url") @db.VarChar(2048)
  infographicUrl    String?          @map("infographic_url") @db.VarChar(2048)
  /// Category attribute sheet values, e.g. {"Fit":"Slim"}.
  attributes        Json             @default("{}")
  featured          Boolean          @default(false)
  category          ProductCategory? @relation("ParentProductCategory", fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_parent_products_category")
  subcategory       ProductCategory? @relation("ParentProductSubcategory", fields: [subcategoryId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_parent_products_subcategory")

  variants Product[]

  @@index([categoryId], map: "idx_parent_products_category_id")
  @@index([subcategoryId], map: "idx_parent_products_subcategory_id")
  @@map("parent_products")
}

/// One purchasable variant SKU.
model Product {
  id                String           @id @default(uuid()) @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deleted           Boolean          @default(false)
  name              String           @db.VarChar(255)
  description       String?
  price             Decimal          @db.Decimal(12, 2)
  stockQuantity     Int              @map("stock_quantity")
  sku               String           @unique(map: "uk_products_sku") @db.VarChar(100)
  status            String           @db.VarChar(20)
  categoryId        String?          @map("category_id") @db.Uuid
  merchantId        String           @map("merchant_id") @db.Uuid
  /// Optimistic-lock counter (was JPA @Version).
  version           BigInt?
  parentId          String           @map("parent_id") @db.Uuid
  variantName       String?          @map("variant_name") @db.VarChar(150)
  color             String?          @db.VarChar(50)
  size              String?          @db.VarChar(50)
  material          String?          @db.VarChar(100)
  pattern           String?          @db.VarChar(100)
  style             String?          @db.VarChar(100)
  mrp               Decimal?         @db.Decimal(12, 2)
  cost              Decimal?         @db.Decimal(12, 2)
  taxCode           String?          @map("tax_code") @db.VarChar(50)
  /// Percent; null falls back to DEFAULT_TAX_RATE.
  taxRate           Decimal?         @map("tax_rate") @db.Decimal(5, 2)
  /// Null falls back to LOW_STOCK_THRESHOLD.
  lowStockThreshold Int?             @map("low_stock_threshold")
  /// Unique among non-null values (uniq_products_url_slug, SQL only).
  urlSlug           String?          @map("url_slug") @db.VarChar(255)
  seoTitle          String?          @map("seo_title") @db.VarChar(255)
  metaDescription   String?          @map("meta_description") @db.VarChar(500)
  searchKeywords    String?          @map("search_keywords") @db.VarChar(1000)
  specifications    String?
  dimensions        String?          @db.VarChar(255)
  weight            String?          @db.VarChar(100)
  shippingClass     String?          @map("shipping_class") @db.VarChar(50)
  supplierId        String?          @map("supplier_id") @db.VarChar(100)
  warehouseId       String?          @map("warehouse_id") @db.VarChar(100)
  category          ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_products_category")
  parent            ParentProduct    @relation(fields: [parentId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_products_parent")

  images         ProductImage[]
  cartItems      CartItem[]
  stockMovements StockMovement[]

  @@index([parentId], map: "idx_products_parent_id")
  @@map("products")
}

model ProductImage {
  id            String    @id @default(uuid()) @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deleted       Boolean   @default(false)
  productId     String    @map("product_id") @db.Uuid
  url           String    @db.VarChar(2048)
  altText       String?   @map("alt_text") @db.VarChar(255)
  position      Int
  isPrimary     Boolean   @default(false) @map("is_primary")
  width         Int?
  height        Int?
  contentType   String?   @map("content_type") @db.VarChar(100)
  fileSizeBytes BigInt?   @map("file_size_bytes")
  storageKey    String?   @map("storage_key") @db.VarChar(512)
  /// OK | BROKEN | UNCHECKED; null = never checked (FR-IM-08).
  checkStatus   String?   @map("check_status") @db.VarChar(20)
  checkError    String?   @map("check_error") @db.VarChar(500)
  checkedAt     DateTime? @map("checked_at") @db.Timestamptz(6)
  product       Product   @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_product_images_product")

  @@index([productId], map: "idx_product_images_product_id")
  @@map("product_images")
}

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deleted   Boolean  @default(false)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_carts_user")

  items CartItem[]

  @@index([userId, deleted], map: "idx_carts_user_id")
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deleted   Boolean  @default(false)
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cart_items_cart")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_cart_items_product")

  @@index([cartId, deleted], map: "idx_cart_items_cart_id")
  @@map("cart_items")
}

model UserAddress {
  id            String   @id @default(uuid()) @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deleted       Boolean  @default(false)
  userId        String   @map("user_id") @db.Uuid
  label         String   @db.VarChar(50)
  recipientName String   @map("recipient_name") @db.VarChar(200)
  phone         String?  @db.VarChar(20)
  addressLine1  String   @map("address_line1") @db.VarChar(255)
  addressLine2  String?  @map("address_line2") @db.VarChar(255)
  city          String   @db.VarChar(100)
  state         String   @db.VarChar(100)
  postalCode    String   @map("postal_code") @db.VarChar(20)
  country       String   @db.VarChar(100)
  isDefault     Boolean  @default(false) @map("is_default")
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_user_addresses_user")

  @@index([userId, deleted], map: "idx_user_addresses_user_id")
  @@map("user_addresses")
}

/// A placed order — a self-contained historical record (prices, names, address snapshotted).
model Order {
  id                   String    @id @default(uuid()) @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deleted              Boolean   @default(false)
  /// Null for a guest order (the customer is identified by customerEmail).
  userId               String?   @map("user_id") @db.Uuid
  orderNumber          String    @unique(map: "uk_orders_order_number") @map("order_number") @db.VarChar(40)
  status               String    @db.VarChar(30)
  currency             String    @db.VarChar(3)
  subtotal             Decimal   @db.Decimal(12, 2)
  taxTotal             Decimal   @map("tax_total") @db.Decimal(12, 2)
  shippingTotal        Decimal   @map("shipping_total") @db.Decimal(12, 2)
  discountTotal        Decimal   @map("discount_total") @db.Decimal(12, 2)
  grandTotal           Decimal   @map("grand_total") @db.Decimal(12, 2)
  paymentStatus        String?   @map("payment_status") @db.VarChar(20)
  paymentReference     String?   @map("payment_reference") @db.VarChar(255)
  paymentIntentId      String?   @map("payment_intent_id") @db.VarChar(255)
  shipRecipientName    String    @map("ship_recipient_name") @db.VarChar(200)
  shipPhone            String?   @map("ship_phone") @db.VarChar(20)
  shipAddressLine1     String    @map("ship_address_line1") @db.VarChar(255)
  shipAddressLine2     String?   @map("ship_address_line2") @db.VarChar(255)
  shipCity             String    @map("ship_city") @db.VarChar(100)
  shipState            String    @map("ship_state") @db.VarChar(100)
  shipPostalCode       String    @map("ship_postal_code") @db.VarChar(20)
  shipCountry          String    @map("ship_country") @db.VarChar(100)
  idempotencyKey       String?   @map("idempotency_key") @db.VarChar(80)
  requestHash          String?   @map("request_hash") @db.VarChar(64)
  cancellationReason   String?   @map("cancellation_reason") @db.VarChar(255)
  cancelledBy          String?   @map("cancelled_by") @db.VarChar(20)
  lastPaymentFailureAt DateTime? @map("last_payment_failure_at") @db.Timestamptz(6)
  customerEmail        String?   @map("customer_email") @db.VarChar(255)
  marketingOptIn       Boolean   @default(false) @map("marketing_opt_in")
  /// SHA-256 (hex) of the guest's order token; the token itself is never stored.
  guestTokenHash       String?   @map("guest_token_hash") @db.VarChar(64)
  /// UNFULFILLED | PICKED | PACKED | SHIPPED | DELIVERED; null until paid.
  fulfilmentStatus     String?   @map("fulfilment_status") @db.VarChar(20)
  shippingMethod       String?   @map("shipping_method") @db.VarChar(20)
  refundedTotal        Decimal   @default(0) @map("refunded_total") @db.Decimal(12, 2)
  paidAt               DateTime? @map("paid_at") @db.Timestamptz(6)
  shippedAt            DateTime? @map("shipped_at") @db.Timestamptz(6)
  deliveredAt          DateTime? @map("delivered_at") @db.Timestamptz(6)
  user                 User?     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_orders_user")

  items         OrderItem[]
  events        OrderEvent[]
  shipments     Shipment[]
  returns       OrderReturn[]
  notifications Notification[]

  @@index([userId, deleted], map: "idx_orders_user_id")
  @@index([customerEmail], map: "idx_orders_customer_email")
  @@index([fulfilmentStatus], map: "idx_orders_fulfilment_status")
  @@index([paidAt], map: "idx_orders_paid_at")
  @@index([paymentIntentId], map: "idx_orders_payment_intent_id")
  @@index([status, createdAt], map: "idx_orders_status_created_at")
  @@map("orders")
}

/// Order line; product fields are snapshots, deliberately without FKs to products/users.
model OrderItem {
  id               String   @id @default(uuid()) @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deleted          Boolean  @default(false)
  orderId          String   @map("order_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  merchantId       String   @map("merchant_id") @db.Uuid
  productName      String   @map("product_name") @db.VarChar(255)
  sku              String   @db.VarChar(100)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity         Int
  lineTotal        Decimal  @map("line_total") @db.Decimal(12, 2)
  taxCode          String?  @map("tax_code") @db.VarChar(50)
  /// Percent applied to this line at checkout (FR-IN-06).
  taxRate          Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount        Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  returnedQuantity Int      @default(0) @map("returned_quantity")
  imageUrl         String?  @map("image_url") @db.VarChar(2048)
  variantName      String?  @map("variant_name") @db.VarChar(150)
  color            String?  @db.VarChar(50)
  size             String?  @db.VarChar(50)
  order            Order    @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_items_order")

  returnItems OrderReturnItem[]

  @@index([orderId], map: "idx_order_items_order_id")
  @@index([merchantId, deleted], map: "idx_order_items_merchant_id")
  @@index([productId], map: "idx_order_items_product_id")
  @@map("order_items")
}

/// Order timeline entry: every status or fulfilment change, with who made it.
model OrderEvent {
  id               String   @id @default(uuid()) @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  orderId          String   @map("order_id") @db.Uuid
  status           String?  @db.VarChar(30)
  fulfilmentStatus String?  @map("fulfilment_status") @db.VarChar(20)
  note             String?  @db.VarChar(1000)
  /// CUSTOMER, ADMIN:<email>, SYSTEM, GATEWAY…
  actor            String?  @db.VarChar(255)
  order            Order    @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_events_order")

  @@index([orderId, createdAt], map: "idx_order_events_order_id")
  @@map("order_events")
}

/// A parcel handed to a carrier (FR-IN-03). provider = the shipping integration (manual for now).
model Shipment {
  id                String    @id @default(uuid()) @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  orderId           String    @map("order_id") @db.Uuid
  provider          String    @db.VarChar(30)
  carrier           String?   @db.VarChar(100)
  service           String?   @db.VarChar(100)
  trackingNumber    String?   @map("tracking_number") @db.VarChar(100)
  trackingUrl       String?   @map("tracking_url") @db.VarChar(2048)
  labelUrl          String?   @map("label_url") @db.VarChar(2048)
  providerReference String?   @map("provider_reference") @db.VarChar(255)
  status            String    @db.VarChar(30)
  deliveredAt       DateTime? @map("delivered_at") @db.Timestamptz(6)
  order             Order     @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_shipments_order")

  events ShipmentEvent[]

  @@index([orderId], map: "idx_shipments_order_id")
  @@index([trackingNumber], map: "idx_shipments_tracking_number")
  @@map("shipments")
}

model ShipmentEvent {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  shipmentId  String   @map("shipment_id") @db.Uuid
  status      String   @db.VarChar(30)
  description String?  @db.VarChar(500)
  location    String?  @db.VarChar(200)
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(6)
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_shipment_events_shipment")

  @@index([shipmentId, occurredAt], map: "idx_shipment_events_shipment_id")
  @@map("shipment_events")
}

/// A return/RMA (FR-AD-07).
model OrderReturn {
  id              String    @id @default(uuid()) @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  orderId         String    @map("order_id") @db.Uuid
  rmaNumber       String    @unique(map: "uk_order_returns_rma_number") @map("rma_number") @db.VarChar(40)
  /// REQUESTED | APPROVED | REJECTED | RECEIVED | REFUNDED
  status          String    @db.VarChar(20)
  reason          String    @db.VarChar(1000)
  /// DROPOFF | PICKUP
  method          String?   @db.VarChar(20)
  /// CUSTOMER | ADMIN
  requestedBy     String    @map("requested_by") @db.VarChar(20)
  adminNote       String?   @map("admin_note") @db.VarChar(1000)
  refundAmount    Decimal?  @map("refund_amount") @db.Decimal(12, 2)
  refundReference String?   @map("refund_reference") @db.VarChar(255)
  restocked       Boolean   @default(false)
  receivedAt      DateTime? @map("received_at") @db.Timestamptz(6)
  refundedAt      DateTime? @map("refunded_at") @db.Timestamptz(6)
  order           Order     @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_returns_order")

  items OrderReturnItem[]

  @@index([orderId], map: "idx_order_returns_order_id")
  @@index([status, createdAt], map: "idx_order_returns_status_created_at")
  @@map("order_returns")
}

model OrderReturnItem {
  id          String      @id @default(uuid()) @db.Uuid
  returnId    String      @map("return_id") @db.Uuid
  orderItemId String      @map("order_item_id") @db.Uuid
  quantity    Int
  orderReturn OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_order_return_items_return")
  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_return_items_order_item")

  @@unique([returnId, orderItemId], map: "uk_order_return_items_return_item")
  @@index([orderItemId], map: "idx_order_return_items_order_item_id")
  @@map("order_return_items")
}

/// Audit trail of every stock change (FR-AD-03).
model StockMovement {
  id            String   @id @default(uuid()) @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  productId     String   @map("product_id") @db.Uuid
  delta         Int
  quantityAfter Int      @map("quantity_after")
  /// ADJUSTMENT | BULK_UPDATE | IMPORT | RETURN | ORDER | CANCELLATION
  source        String   @db.VarChar(20)
  reason        String?  @db.VarChar(500)
  actor         String?  @db.VarChar(255)
  product       Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_stock_movements_product")

  @@index([productId, createdAt], map: "idx_stock_movements_product_id")
  @@map("stock_movements")
}

/// FR-IN-05. Deliberately without FKs: events outlive what they reference.
model AnalyticsEvent {
  id         String   @id @default(uuid()) @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  eventType  String   @map("event_type") @db.VarChar(30)
  sessionId  String?  @map("session_id") @db.VarChar(100)
  userId     String?  @map("user_id") @db.Uuid
  productId  String?  @map("product_id") @db.Uuid
  orderId    String?  @map("order_id") @db.Uuid
  value      Decimal? @db.Decimal(12, 2)
  currency   String?  @db.VarChar(3)
  path       String?  @db.VarChar(2048)
  properties Json?

  @@index([eventType, createdAt], map: "idx_analytics_events_type_created_at")
  @@index([productId], map: "idx_analytics_events_product_id")
  @@map("analytics_events")
}

/// Every customer message the mailer produced (MAIL_PROVIDER=log stores them here only).
model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  orderId   String?  @map("order_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  template  String   @db.VarChar(40)
  subject   String   @db.VarChar(255)
  toAddress String   @map("to_address") @db.VarChar(255)
  body      String
  /// LOGGED | SENT | FAILED
  status    String   @db.VarChar(20)
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_notifications_order")
  user      User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_notifications_user")

  @@index([orderId], map: "idx_notifications_order_id")
  @@index([userId], map: "idx_notifications_user_id")
  @@index([createdAt], map: "idx_notifications_created_at")
  @@map("notifications")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 (hex) of the emailed token.
  tokenHash String    @unique(map: "uk_password_reset_tokens_token_hash") @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_password_reset_tokens_user")

  @@index([userId], map: "idx_password_reset_tokens_user_id")
  @@map("password_reset_tokens")
}

model SellerApplication {
  id         String   @id @default(uuid()) @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  reference  String   @unique(map: "uk_seller_applications_reference") @db.VarChar(20)
  fullName   String   @map("full_name") @db.VarChar(200)
  email      String   @db.VarChar(255)
  phone      String   @db.VarChar(30)
  categories String[]
  products   String
  street     String   @db.VarChar(255)
  city       String   @db.VarChar(100)
  state      String   @db.VarChar(100)
  postalCode String   @map("postal_code") @db.VarChar(20)
  status     String   @default("NEW") @db.VarChar(20)

  @@index([status, createdAt], map: "idx_seller_applications_status")
  @@map("seller_applications")
}

model SupportMessage {
  id           String   @id @default(uuid()) @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  ticketNumber String   @unique(map: "uk_support_messages_ticket_number") @map("ticket_number") @db.VarChar(20)
  name         String   @db.VarChar(200)
  email        String   @db.VarChar(255)
  topic        String   @db.VarChar(50)
  orderNumber  String?  @map("order_number") @db.VarChar(40)
  message      String
  status       String   @default("OPEN") @db.VarChar(20)

  @@index([status, createdAt], map: "idx_support_messages_status")
  @@map("support_messages")
}

/// Durable payment-provider webhook event, keyed by the provider's event id.
model WebhookEvent {
  eventId      String    @id @map("event_id") @db.VarChar(255)
  eventType    String?   @map("event_type") @db.VarChar(100)
  payload      String?
  status       String    @db.VarChar(20)
  errorMessage String?   @map("error_message") @db.VarChar(1000)
  receivedAt   DateTime  @map("received_at") @db.Timestamptz(6)
  processedAt  DateTime? @map("processed_at") @db.Timestamptz(6)

  @@index([status], map: "idx_webhook_events_status")
  @@map("webhook_events")
}
