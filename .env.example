# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexus_commerce
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ── JPA / Hibernate ───────────────────────────────────────────────────────────
# Options: create | create-drop | update | validate | none
# Flyway now owns the schema, so this defaults to 'validate'. Override with
# 'update' only for throwaway local experiments.
JPA_DDL_AUTO=validate

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED: replace with a strong 256-bit (32+ char) secret — never commit the real value
JWT_SECRET=replace_with_a_strong_256bit_secret
# Access token lifetime in milliseconds  (default: 24 h = 86400000)
JWT_EXPIRATION_MS=86400000
# Refresh token lifetime in milliseconds (default:  7 d = 604800000)
JWT_REFRESH_EXPIRATION_MS=604800000

# ── Payments ──────────────────────────────────────────────────────────────────
# Active gateway: 'manual' (default) or 'stripe'.
PAYMENT_PROVIDER=manual
# Stripe credentials — required only when PAYMENT_PROVIDER=stripe.
# Secret API key from the Stripe Dashboard (use sk_test_… outside production).
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…). From the Dashboard endpoint, or printed by
# `stripe listen` when forwarding events locally.
STRIPE_WEBHOOK_SECRET=
