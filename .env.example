# Same variables as the Java server's .env — one file can serve both.

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
# 'framework' behind a reverse proxy / load balancer (trust X-Forwarded-For for
# the client IP); 'none' when the app is reached directly.
SERVER_FORWARD_HEADERS_STRATEGY=none
# debug | info | warn | error
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────────
# Either a full URL…
# DATABASE_URL=postgresql://user:password@localhost:5432/nexus_commerce
# …or the parts:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexus_commerce
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED: at least 32 bytes — never commit the real value. Use the Java
# server's secret to keep existing tokens valid across the switch.
JWT_SECRET=replace_with_a_strong_256bit_secret
# Access token lifetime in milliseconds (default 24 h)
JWT_EXPIRATION_MS=86400000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated exact origins (credentials are sent, so no '*').
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Addresses / orders ───────────────────────────────────────────────────────
USER_ADDRESS_MAX_PER_USER=5
ORDER_CURRENCY=USD
# Minutes a Stripe PENDING_PAYMENT order holds stock before it expires (0 = never).
ORDER_PENDING_EXPIRY_MINUTES=30
ORDER_EXPIRY_CHECK_INTERVAL_MS=60000

# ── Auth rate limiting (per client IP, login + register) ─────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_CAPACITY=10
RATE_LIMIT_AUTH_REFILL_PER_MINUTE=10

# ── Payments ──────────────────────────────────────────────────────────────────
# 'manual' (default) or 'stripe'.
PAYMENT_PROVIDER=manual
# Required only when PAYMENT_PROVIDER=stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Catalog import ────────────────────────────────────────────────────────────
CATALOG_IMPORT_MAX_FILE_SIZE=10MB
CATALOG_IMPORT_MAX_ROWS=5000
